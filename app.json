{
  "expo": {
    "name": "BuzzWheel",
    "slug": "BuzzWheel",
    "version": "1.0.6",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/images/icons_ios/icon-a.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./assets/locales/en.json",
      "ru": "./assets/locales/ru.json",
      "fr": "./assets/locales/fr.json",
      "de": "./assets/locales/de.json",
      "pl": "./assets/locales/pl.json",
      "es": "./assets/locales/es.json",
      "fil": "./assets/locales/fil.json"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibragimlol.BuzzWheel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "icon": "./assets/images/icons_ios/icon-a.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons_ios/icon-a.png",
        "backgroundColor": "#FCC900"
      },
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "package": "com.ibragimlol.BuzzWheel"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidLintOptions.js",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C111C",
          "android": {
            "image": "./assets/images/icons_ios/icon-a.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Buzz Wheel to use the microphone to record your voice for the selected functionality."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "buzzwheel",
          "organization": "mydream-6o"
        }
      ],
      "expo-localization",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconRefined",
            "ios": "./assets/images/icons_ios/variants/v1_refined.png",
            "android": {
              "foregroundImage": "./assets/images/icons_ios/variants/v1_refined.png",
              "backgroundColor": "#FFC400"
            }
          },
          {
            "name": "IconBeeFace",
            "ios": "./assets/images/icons_ios/variants/v2_bee_face.png",
            "android": {
              "foregroundImage": "./assets/images/icons_ios/variants/v2_bee_face.png",
              "backgroundColor": "#4B2DB8"
            }
          },
          {
            "name": "IconDevilBee",
            "ios": "./assets/images/icons_ios/variants/v4_devil_bee.png",
            "android": {
              "foregroundImage": "./assets/images/icons_ios/variants/v4_devil_bee.png",
              "backgroundColor": "#D4202E"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1f969f83-2d04-4a6a-ab0a-44323df0de8c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "ibragimlol",
    "updates": {
      "url": "https://u.expo.dev/1f969f83-2d04-4a6a-ab0a-44323df0de8c"
    }
  }
}
